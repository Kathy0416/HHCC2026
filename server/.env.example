# 服务端口
PORT=3000

# JWT 签名密钥（生产环境务必改为随机长字符串）
JWT_SECRET=please-change-this-to-a-random-secret

# 数据库文件路径（可选，默认 server/data.db）
# DB_PATH=./data.db

# DeepSeek API 配置（用于 AI 助手代理，密钥只保存在服务端，不再暴露给浏览器）
# 留空则 AI 助手使用服务端内置的本地模拟回复
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# 是否由后端托管前端静态文件（1 = 开启；默认关闭，前端可单独部署）
# SERVE_FRONTEND=1
b